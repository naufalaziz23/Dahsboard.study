datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x", "debian-openssl-3.0.x"]
}

enum ProjectStatus {
  PLANNING
  IN_PROGRESS
  ON_HOLD
  COMPLETED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum CalendarCategory {
  WRITING
  DEADLINE
  CONSULTATION
  ACADEMIC
  DATA_COLLECTION
  OTHER
}

model User {
  id              String            @id @default(cuid())
  name            String
  email           String            @unique
  passwordHash    String
  avatar          String?           @db.Text
  role            String            @default("Student")
  university      String            @default("UNY")
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  projects        Project[]
  tasks           Task[]
  documents       Document[]
  folders         Folder[]
  calendarEvents  CalendarEvent[]
  notes           Note[]
  references      Reference[]
  writingSessions WritingSession[]
  archivedItems   ArchivedItem[]
  attachments     Attachment[]

  @@map("users")
}

model Project {
  id              String            @id @default(cuid())
  userId          String
  title           String
  subtitle        String?
  description     String?           @db.Text
  status          ProjectStatus     @default(IN_PROGRESS)
  priority        Priority          @default(MEDIUM)
  category        String            @default("Skripsi")
  startDate       DateTime?
  deadline        DateTime?
  completedAt     DateTime?
  isArchived      Boolean           @default(false)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks           Task[]
  documents       Document[]
  calendarEvents  CalendarEvent[]
  notes           Note[]
  references      Reference[]
  attachments     Attachment[]

  @@index([userId])
  @@index([status])
  @@index([isArchived])
  @@map("projects")
}

model Task {
  id              String            @id @default(cuid())
  projectId       String?
  userId          String
  title           String
  description     String?           @db.Text
  status          TaskStatus        @default(TODO)
  priority        Priority          @default(MEDIUM)
  startDate       DateTime?
  deadline        DateTime?
  completedAt     DateTime?
  position        Int               @default(0)
  timeSlot        String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  project         Project?          @relation(fields: [projectId], references: [id], onDelete: SetNull)
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  calendarEvents  CalendarEvent[]

  @@index([userId])
  @@index([projectId])
  @@index([status])
  @@map("tasks")
}

model Document {
  id              String            @id @default(cuid())
  userId          String
  projectId       String?
  folderId        String?
  title           String
  content         String            @db.LongText
  contentFormat   String            @default("html_tiptap")
  wordCount       Int               @default(0)
  characterCount  Int               @default(0)
  isArchived      Boolean           @default(false)
  lastEditedAt    DateTime          @default(now())
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  project         Project?          @relation(fields: [projectId], references: [id], onDelete: SetNull)
  folder          Folder?           @relation(fields: [folderId], references: [id], onDelete: SetNull)
  writingSessions WritingSession[]
  notes           Note[]
  attachments     Attachment[]

  @@index([userId])
  @@index([projectId])
  @@index([folderId])
  @@index([isArchived])
  @@map("documents")
}

model Folder {
  id              String            @id @default(cuid())
  userId          String
  name            String
  parentId        String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent          Folder?           @relation("FolderHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  subFolders      Folder[]          @relation("FolderHierarchy")
  documents       Document[]

  @@index([userId])
  @@index([parentId])
  @@map("folders")
}

model CalendarEvent {
  id              String            @id @default(cuid())
  userId          String
  projectId       String?
  taskId          String?
  title           String
  description     String?           @db.Text
  category        CalendarCategory  @default(WRITING)
  startAt         DateTime
  endAt           DateTime?
  allDay          Boolean           @default(false)
  completed       Boolean           @default(false)
  color           String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  project         Project?          @relation(fields: [projectId], references: [id], onDelete: SetNull)
  task            Task?             @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([projectId])
  @@index([taskId])
  @@index([startAt])
  @@map("calendar_events")
}

model Note {
  id              String            @id @default(cuid())
  userId          String
  projectId       String?
  documentId      String?
  title           String
  content         String            @db.Text
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  project         Project?          @relation(fields: [projectId], references: [id], onDelete: SetNull)
  document        Document?         @relation(fields: [documentId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([projectId])
  @@index([documentId])
  @@map("notes")
}

model Reference {
  id              String            @id @default(cuid())
  userId          String
  projectId       String?
  title           String
  author          String
  publicationYear String
  url             String?           @db.Text
  description     String?           @db.Text
  citation        String?           @db.Text
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  project         Project?          @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([projectId])
  @@map("references")
}

model WritingSession {
  id              String            @id @default(cuid())
  userId          String
  documentId      String?
  startedAt       DateTime
  endedAt         DateTime
  durationMinutes Int
  wordsAdded      Int               @default(0)
  createdAt       DateTime          @default(now())

  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  document        Document?         @relation(fields: [documentId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([documentId])
  @@index([startedAt])
  @@map("writing_sessions")
}

model ArchivedItem {
  id              String            @id @default(cuid())
  userId          String
  itemType        String            // "PROJECT", "DOCUMENT", "FILE"
  originalId      String?
  title           String
  archivedAt      DateTime          @default(now())
  metadata        Json?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([itemType])
  @@map("archived_items")
}

model Attachment {
  id              String            @id @default(cuid())
  userId          String
  projectId       String?
  documentId      String?
  fileName        String
  originalName    String
  mimeType        String
  fileSize        Int
  storagePath     String
  createdAt       DateTime          @default(now())

  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  project         Project?          @relation(fields: [projectId], references: [id], onDelete: SetNull)
  document        Document?         @relation(fields: [documentId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([projectId])
  @@index([documentId])
  @@map("attachments")
}

