# Database Configuration (MySQL on custom port 3307 with password123)
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://root:password123@127.0.0.1:3307/studyflow_db"

# Authentication & Session Security
# Generate a secure 32+ byte secret for production: `openssl rand -base64 32`
AUTH_SECRET="studyflow_secure_jwt_session_secret_key_2026_super_safe"

# Timezone
TZ="Asia/Jakarta"
NEXT_PUBLIC_APP_TIMEZONE="Asia/Jakarta"

# File Uploads Directory (Relative to project root or absolute path)
UPLOAD_DIR="uploads"
